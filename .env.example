# Min cross-venue spread % to trigger TG alert
MIN_SPREAD_PCT=6.0

# Scanner tick interval (seconds)
SCAN_INTERVAL_SEC=5

# Max age of a price record before it's considered stale (seconds)
MAX_PRICE_AGE_SEC=30

# Re-alert cooldown for the same (token, direction) pair (seconds)
ALERT_COOLDOWN_SEC=300

# DexScreener poll interval per token (seconds, jittered)
DEX_POLL_INTERVAL_SEC=20

# Telegram bot — create new via @BotFather for this project
TELEGRAM_BOT_TOKEN=
CHAT_ID=
# Optional: forum thread id; leave empty for normal chats
THREAD_ID=

# Optional CoinGecko Pro key (raises rate limits for token_resolver bootstrap)
COINGECKO_API_KEY=
